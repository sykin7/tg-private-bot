# ============================================================
# CodexBot 环境变量示例
# ============================================================
# 这个文件可以提交到 GitHub，因为这里不应该填写真实密钥。
# 部署时请复制成 .env，然后只在 VPS 本机的 .env 里填写真实值：
#
#   cp .env.example .env
#   nano .env
#
# 注意：.env 已被 .gitignore 和 .dockerignore 排除，不会提交到 GitHub，
# 也不会被打进 Docker 镜像。


# ============================================================
# Telegram Bot 必需配置
# ============================================================

# 必填：BotFather 提供的机器人 Token。
# 示例格式类似：123456789:AAxxxxxx
# 不要把真实 token 写进 .env.example。
BOT_TOKEN=

# 必填：管理员 Telegram 数字 ID。
# 可以找 Telegram 里的 @userinfobot 获取。
# ADMIN_ID 和 OWNER_ID 二选一即可，推荐使用 ADMIN_ID。
ADMIN_ID=
OWNER_ID=


# ============================================================
# 数据存储配置
# ============================================================

# SQLite 数据库路径，Docker 部署时固定为容器内 /app/data/bot_core.db。
BOT_DB_PATH=/app/data/bot_core.db


# ============================================================
# 验证码配置
# ============================================================

# 默认 false：用户必须点击按钮验证码。
# 设为 true：也允许用户直接发送文本数字答案。
# 为了减少脚本猜答案，生产环境推荐保持 false。
CAPTCHA_TEXT_FALLBACK=false


# ============================================================
# 自定义提示语，可选
# ============================================================
# 留空则使用代码里的默认文案。

# 中文欢迎语。
WELCOME_ZH=

# 中文验证通过提示。
VERIFIED_ZH=

# 中文自动回复提示。
AUTO_REPLY_ZH=

# 英文欢迎语。
WELCOME_EN=

# 英文验证通过提示。
VERIFIED_EN=

# 英文自动回复提示。
AUTO_REPLY_EN=


# ============================================================
# 远程反垃圾规则，可选
# ============================================================

# 远程垃圾词列表地址。
# 留空则使用代码默认地址：
# https://raw.githubusercontent.com/sykin7/my-telegram-spam-rules/refs/heads/main/spam.txt
REMOTE_SPAM_URL=


# ============================================================
# 第三方 AI 广告识别，可选
# ============================================================
# 留空或关闭时，机器人完全使用本地规则 + 第三方广告词规则，功能不受影响。

# 是否启用 AI 判定。true 时才需要配置下面几个变量。
AI_ENABLED=false

# AI 协议，支持三种：
#   openai-compatible：OpenAI 兼容 Chat Completions，默认值，兼容绝大多数第三方网关
#   anthropic：Anthropic Claude 原生 Messages API
#   gemini：Google Gemini 原生 generateContent
AI_PROVIDER=openai-compatible

# 按 AI_PROVIDER 填对应的 API 地址：
#   openai-compatible：https://api.openai.com/v1、https://api.deepseek.com/v1
#   anthropic：https://api.anthropic.com
#   gemini：https://generativelanguage.googleapis.com
AI_BASE_URL=

# 第三方模型 API Key。只填写在 VPS 的 .env 里，不要提交到 GitHub。
AI_API_KEY=

# 模型名称。不同服务商写法不同，例如 gpt-4o-mini、deepseek-chat、
# claude-3-5-sonnet-latest、gemini-2.0-flash。
AI_MODEL=gpt-4o-mini

# 单次 AI 回复最大 token 数。Anthropic 必填，默认 300。
AI_MAX_TOKENS=300

# true：请求模型返回 JSON；false：只靠提示词约束输出。
# Anthropic 无标准 JSON 参数，只能靠提示词约束。
# 建议聚合网关先设 true，让模型强制返回 JSON，识别更稳。
# 若网关报 HTTP 400 拒绝该参数，再改回 false，代码有文本兜底判定。
AI_RESPONSE_FORMAT=true

# 单次 AI 请求超时秒数。聚合网关首字慢，建议 45。
AI_TIMEOUT=45

# 本地风险分达到该值时触发 AI 复核。默认 5。
AI_MIN_SCORE=5

# true：所有待判定内容都请求 AI；false：只有达到风险阈值才请求 AI。
AI_ALWAYS_CHECK=false

# true：入群申请也会对用户资料做 AI 判定。
AI_PROFILE_CHECK=true


# ============================================================
# 广告规则学习与同步，可选
# ============================================================
# 机器人拦截广告后会把稳定特征写进 SQLite 的 spam_feedback 表；
# 同一特征重复命中达到阈值后自动确认学习，管理员按钮仍可手动确认或忽略。
# 不填写下面任何同步配置时，只保存到本地数据库，不会推送任何远程规则文件。

# 是否启用广告规则学习。false 时不保存反馈，也不同步。
RULE_LEARN_ENABLED=true

# 是否启用自动学习。true 时同一特征命中 RULE_AUTO_LEARN_THRESHOLD 次自动确认。
RULE_AUTO_LEARN_ENABLED=true

# 同一广告特征重复命中多少次后自动学习。默认 3。
RULE_AUTO_LEARN_THRESHOLD=3

# spam_feedback 表最多保留多少条。超出后先清最旧未确认样本，再清最旧已同步样本。
RULE_AUTO_LEARN_MAX_RULES=200000

# 未确认样本保留天数，超期自动清理。默认 30。
RULE_AUTO_LEARN_RETENTION_DAYS=30

# 管理员忽略样本保留天数，超期自动清理。默认 7。
RULE_IGNORE_RETENTION_DAYS=7

# 最多把多少条学习特征加载进内存参与判断，控制 1c1h5g VPS 的内存占用。
RULE_LEARNED_MEMORY_LIMIT=50000

# 学习特征精确匹配的最大条数。
RULE_EXACT_MAX_TERMS=200000

# 第三方普通规则编译成正则时的最大关键词数，超出部分截断。
RULE_REGEX_MAX_KEYWORDS=20000

# 正则分批编译大小，避免单条超大正则占用过多内存。
RULE_REGEX_BATCH_SIZE=2000

# 每次给 AI 的关键词上限，防止提示词过长拖慢响应。默认 200。
AI_KEYWORDS_LIMIT=200

# GitHub 规则仓库，格式 owner/repo，例如 sykin7/my-telegram-spam-rules。
RULE_SYNC_GITHUB_REPO=

# 仓库内规则文件路径，例如 spam.txt 或 rules/spam.txt。
RULE_SYNC_GITHUB_PATH=

# 写入规则文件的分支。
RULE_SYNC_GITHUB_BRANCH=main

# GitHub Personal Access Token，需要该仓库 contents 读写权限。
# 只填写在 VPS 的 .env 里，不要提交到 GitHub。
RULE_SYNC_GITHUB_TOKEN=

# Cloudflare R2 S3 API 端点，例如 https://你的账号ID.r2.cloudflarestorage.com。
RULE_SYNC_R2_ENDPOINT=

# R2 存储桶名称。
RULE_SYNC_R2_BUCKET=

# R2 对象键，例如 spam.txt 或 rules/spam.txt。
RULE_SYNC_R2_KEY=

# R2 区域，默认 auto。
RULE_SYNC_R2_REGION=auto

# R2 Access Key ID 和 Secret Access Key，只填写在 VPS 的 .env 里。
RULE_SYNC_R2_ACCESS_KEY=
RULE_SYNC_R2_SECRET_KEY=

# 需要多个 R2 账户自动切换时，把第一组变量复制为 _2、_3 ... _20。
# 例如第二组账户：
# RULE_SYNC_R2_ENDPOINT_2=https://你的账号ID2.r2.cloudflarestorage.com
# RULE_SYNC_R2_BUCKET_2=你的存储桶名2
# RULE_SYNC_R2_KEY_2=spam.txt
# RULE_SYNC_R2_REGION_2=auto
# RULE_SYNC_R2_ACCESS_KEY_2=你的R2AccessKeyID2
# RULE_SYNC_R2_SECRET_KEY_2=你的R2SecretAccessKey2
# 第一个账户配额用满或限流时自动切换下一个可用账户；
# 多个账户会定时镜像同步，保持规则文本一致，任一账户恢复后立即补同步。

# 配置 R2 同步后，机器人也会从上面的 R2 对象拉取规则参与判断，
# 规则先落到本地 SQLite，日常判定和学习都直接走本地，不每次请求 R2。
# 形成“学习 -> 本地生效 -> 每3小时备份进 R2 -> 每3小时拉回本地”的闭环。
# R2 同步始终用 PUT 覆盖写同一个 RULE_SYNC_R2_KEY 对象，不会每次生成新对象。

# R2 用量计数 SQLite 路径，落盘在同一个数据卷里。
R2_USAGE_PATH=/app/data/r2_usage.db

# 本地规则镜像 SQLite 路径。留空时复用 R2_USAGE_PATH 所在的 r2_usage.db。
R2_LOCAL_RULES_PATH=

# R2 拉取缓存秒数。默认 10800（每3小时一次），日常判定不请求 R2。
R2_FETCH_INTERVAL=10800

# R2 免费存储上限，默认 10 GB；写入前先检查，超过 9 GB 硬上限就拒绝写入并提醒管理员。
R2_MAX_STORAGE_GB=10

# R2 免费存储写入硬上限比例。默认 0.9，即 9 GB；超过就拒绝写入，保证不超 9 GB。
R2_STORAGE_WARN_RATIO=0.9

# R2 免费层 Class A（写操作）每月请求上限。
# Cloudflare 免费层是 100 万次/月，这里默认只用到 90% 即 90 万次，保留 10% 冗余。
R2_MAX_CLASS_A_MONTHLY=900000

# R2 免费层 Class B（读操作）每月请求上限。
# Cloudflare 免费层是 1000 万次/月，这里默认只用到 90% 即 900 万次，保留 10% 冗余。
R2_MAX_CLASS_B_MONTHLY=9000000

# 收到 R2 429/503 限流后暂停 R2 请求的秒数。默认 1 小时。
# 暂停期间本地广告判定、GitHub 同步和规则缓存都不受影响。
R2_RATE_LIMIT_COOLDOWN=3600

# 多 R2 账户镜像同步间隔秒数。默认 10800（每3小时一次）；
# 任一账户恢复后会自动立即补同步，不受该间隔限制。
R2_MIRROR_INTERVAL=10800

# 学习规则写入 R2 的同步间隔秒数。默认 10800（每3小时一次）。
# 学习后的规则先立即写入本地 SQLite 生效，到点才统一推送到 R2，
# 避免每小时刷新循环对 R2 产生额外写请求。
R2_SYNC_INTERVAL=10800

# R2 触顶或限流时机器人会向 ADMIN_ID 发送提醒，同一自然月只提醒一次。
# Cloudflare 免费配额按 UTC 自然月重置，次月自动恢复，无需手动干预。


# ============================================================
# 群聊管理，可选
# ============================================================
# 机器人必须被设为目标群的管理员，才能通过/拒绝入群申请、删除消息和封禁成员。

# 是否启用群聊广告管理与入群审核。
GROUP_ENABLED=true

# 是否接管入群申请（Join Requests）。群内开启“需要审核”时有效。
GROUP_JOIN_APPROVE=true

# 正常申请是否自动通过。false 时只通知管理员，由管理员按钮决定。
GROUP_AUTO_APPROVE=true

# 进入人工审核后，管理员超时未处理时按规则自动兜底的等待秒数。
# 默认 600 秒（10 分钟）：广告判定自动拒绝并在该群封禁，用户仍可私聊申诉，正常判定自动通过。
GROUP_JOIN_REVIEW_TIMEOUT=600

# 可选：入群前必须关注的频道。填 @username 或数字频道 ID；留空关闭。
# bot 需要已加入该频道（建议设为频道管理员）才能检查关注状态。
GROUP_JOIN_REQUIRED_CHANNEL=

# 群内广告是否永久封禁发广告用户。
GROUP_BAN_ON_SPAM=true

# 群内广告是否删除原消息。
GROUP_DELETE_SPAM=true

# 只管理这些群。逗号分隔数字群 ID；留空表示管理所有已启用群聊。
GROUP_IDS=

# 接收入群审核和广告通知的管理员数字 ID。逗号分隔；留空时使用 ADMIN_ID。
# Telegram 群原生管理员无需配置，会自动识别，仅可处理本群入群审核。
GROUP_ADMIN_IDS=


# ============================================================
# 旧 Web 后台/企业版配置，当前独立 CodexBot 不使用
# ============================================================
# 下面这些变量来自旧项目模板，当前 new.py / 机器.py 不读取它们。
# 如果你以后重新接入 Web 后台、API 服务、监控或请求签名，可以再启用。
# 现在仅作为迁移参考保留，不需要在 VPS 的 .env 里填写。

# 管理员后端密码。当前独立 Telegram bot 不使用。
ADMIN_BACKEND_PASSWORD=

# 日志级别。当前代码固定使用 INFO，没有读取 LOG_LEVEL。
LOG_LEVEL=INFO

# Prometheus 指标收集。当前独立 Telegram bot 不使用。
ENABLE_METRICS=false

# 审计日志。当前独立 Telegram bot 不使用。
ENABLE_AUDIT_LOG=false

# 优雅关闭开关。当前独立 Telegram bot 不读取该变量。
ENABLE_GRACEFUL_SHUTDOWN=true

# 强制 HTTPS。当前独立 Telegram bot 不提供 Web 服务，不使用。
ENFORCE_HTTPS=false

# 会话密钥轮换间隔。当前独立 Telegram bot 不使用。
SESSION_KEY_ROTATION_INTERVAL=300

# 房间超时时间。当前独立 Telegram bot 不使用。
ROOM_TIMEOUT=600

# 旧 SQLite/本地数据库路径。当前 Docker bot 使用 BOT_DB_PATH。
DB_PATH=./data/storage.db

# 数据库连接池大小。当前独立 Telegram bot 不使用。
DB_POOL_SIZE=5

# Web 服务监听端口。当前独立 Telegram bot 不监听 HTTP 端口。
PORT=5000

# Telegram 通知变量。当前独立 Telegram bot 使用 BOT_TOKEN / ADMIN_ID。
TG_BOT_TOKEN=
TG_ADMIN_ID=

# CORS 配置。当前独立 Telegram bot 不使用。
CORS_ORIGINS=*

# IP 白名单/黑名单。当前独立 Telegram bot 不使用。
ENABLE_IP_WHITELIST=false
IP_WHITELIST=
ENABLE_IP_BLACKLIST=false
IP_BLACKLIST=

# 请求签名验证。当前独立 Telegram bot 不使用。
ENABLE_REQUEST_SIGNATURE=false
SIGNATURE_ALGORITHM=HMAC-SHA256
SIGNATURE_HEADER=X-Signature
SIGNATURE_TIMESTAMP_HEADER=X-Timestamp
SIGNATURE_TOLERANCE_SECONDS=300
