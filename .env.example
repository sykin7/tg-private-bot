# ============================================================
# CodexBot 环境变量示例
# ============================================================
# 这个文件可以提交到 GitHub，因为这里不应该填写真实密钥。
# 部署时请复制成 .env，然后只在 VPS 本机的 .env 里填写真实值：
#
#   cp .env.example .env
#   nano .env
#
# 注意：.env 已被 .gitignore 和 .dockerignore 排除，不会提交到 GitHub，
# 也不会被打进 Docker 镜像。


# ============================================================
# Telegram Bot 必需配置
# ============================================================

# 必填：BotFather 提供的机器人 Token。
# 示例格式类似：123456789:AAxxxxxx
# 不要把真实 token 写进 .env.example。
BOT_TOKEN=

# 必填：管理员 Telegram 数字 ID。
# 可以找 Telegram 里的 @userinfobot 获取。
# ADMIN_ID 和 OWNER_ID 二选一即可，推荐使用 ADMIN_ID。
ADMIN_ID=
OWNER_ID=


# ============================================================
# PostgreSQL 配置
# ============================================================
# Docker Compose 会启动一个内部 PostgreSQL 容器。
# PostgreSQL 默认不暴露公网端口，只给 CodexBot 容器内部访问。

# 数据库名。
POSTGRES_DB=bot_db

# 数据库用户名。
POSTGRES_USER=bot_user

# 必填：数据库密码。
# 生产环境必须改成强密码，只填写在 VPS 的 .env 里。
POSTGRES_PASSWORD=


# ============================================================
# Redis 配置
# ============================================================
# Docker Compose 会启动一个内部 Redis 容器。
# Redis 默认不暴露公网端口，只给 CodexBot 容器内部访问。

# 是否启用 Redis。
# true：使用 Redis 保存限流、验证码冷却等临时状态。
# false：回退到内存状态，容器重启后临时状态会丢失。
REDIS_ENABLED=true

# Redis 连接地址。
# 使用 docker-compose.bot.yml 部署时不要改，容器内服务名就是 redis。
REDIS_URL=redis://redis:6379/0

# Redis 密码。
# 当前 docker-compose.bot.yml 默认没有给 Redis 设置密码，通常留空即可。
# 如果你自己改了 Redis 启动参数和 REDIS_URL，再同步配置这里。
REDIS_PASSWORD=


# ============================================================
# 数据迁移配置
# ============================================================

# 只有第一次从旧 SQLite 数据库导入 PostgreSQL 时才设为 true。
# 迁移完成后必须改回 false，然后重启 CodexBot。
MIGRATE_SQLITE_TO_POSTGRES=false

# 旧 SQLite 数据库路径。
# docker-compose.bot.yml 已固定传入 /app/data/bot_core.db。
# 普通部署不需要修改。
BOT_DB_PATH=/app/data/bot_core.db


# ============================================================
# 验证码配置
# ============================================================

# 默认 false：用户必须点击按钮验证码。
# 设为 true：也允许用户直接发送文本数字答案。
# 为了减少脚本猜答案，生产环境推荐保持 false。
CAPTCHA_TEXT_FALLBACK=false


# ============================================================
# 自定义提示语，可选
# ============================================================
# 留空则使用代码里的默认文案。

# 中文欢迎语。
WELCOME_ZH=

# 中文验证通过提示。
VERIFIED_ZH=

# 中文自动回复提示。
AUTO_REPLY_ZH=

# 英文欢迎语。
WELCOME_EN=

# 英文验证通过提示。
VERIFIED_EN=

# 英文自动回复提示。
AUTO_REPLY_EN=


# ============================================================
# 远程反垃圾规则，可选
# ============================================================

# 远程垃圾词列表地址。
# 留空则使用代码默认地址：
# https://raw.githubusercontent.com/sykin7/my-telegram-spam-rules/refs/heads/main/spam.txt
REMOTE_SPAM_URL=


# ============================================================
# 旧 Web 后台/企业版配置，当前独立 CodexBot 不使用
# ============================================================
# 下面这些变量来自旧项目模板，当前 new.py / 机器.py 不读取它们。
# 如果你以后重新接入 Web 后台、API 服务、监控或请求签名，可以再启用。
# 现在仅作为迁移参考保留，不需要在 VPS 的 .env 里填写。

# 管理员后端密码。当前独立 Telegram bot 不使用。
ADMIN_BACKEND_PASSWORD=

# 日志级别。当前代码固定使用 INFO，没有读取 LOG_LEVEL。
LOG_LEVEL=INFO

# Prometheus 指标收集。当前独立 Telegram bot 不使用。
ENABLE_METRICS=false

# 审计日志。当前独立 Telegram bot 不使用。
ENABLE_AUDIT_LOG=false

# 优雅关闭开关。当前独立 Telegram bot 不读取该变量。
ENABLE_GRACEFUL_SHUTDOWN=true

# 强制 HTTPS。当前独立 Telegram bot 不提供 Web 服务，不使用。
ENFORCE_HTTPS=false

# 会话密钥轮换间隔。当前独立 Telegram bot 不使用。
SESSION_KEY_ROTATION_INTERVAL=300

# 房间超时时间。当前独立 Telegram bot 不使用。
ROOM_TIMEOUT=600

# 旧 SQLite/本地数据库路径。当前 Docker bot 使用 BOT_DB_PATH。
DB_PATH=./data/storage.db

# 数据库连接池大小。当前独立 Telegram bot 不使用。
DB_POOL_SIZE=5

# Web 服务监听端口。当前独立 Telegram bot 不监听 HTTP 端口。
PORT=5000

# Telegram 通知变量。当前独立 Telegram bot 使用 BOT_TOKEN / ADMIN_ID。
TG_BOT_TOKEN=
TG_ADMIN_ID=

# CORS 配置。当前独立 Telegram bot 不使用。
CORS_ORIGINS=*

# IP 白名单/黑名单。当前独立 Telegram bot 不使用。
ENABLE_IP_WHITELIST=false
IP_WHITELIST=
ENABLE_IP_BLACKLIST=false
IP_BLACKLIST=

# 请求签名验证。当前独立 Telegram bot 不使用。
ENABLE_REQUEST_SIGNATURE=false
SIGNATURE_ALGORITHM=HMAC-SHA256
SIGNATURE_HEADER=X-Signature
SIGNATURE_TIMESTAMP_HEADER=X-Timestamp
SIGNATURE_TOLERANCE_SECONDS=300
