# ======== 必需配置 ==========
# 管理员后端密码（生产环境务必修改为强密码）
# 最少 8 个字符，建议包含大小写字母、数字和特殊符号
ADMIN_BACKEND_PASSWORD=change_me_in_production

# ========== Redis 配置 ==========
# 是否启用 Redis（true/false）
# 启用后支持分布式部署和消息持久化
REDIS_ENABLED=false
# Redis 连接地址
REDIS_URL=redis://redis:6379/0
# Redis 密码（可选，生产环境建议设置）
REDIS_PASSWORD=

# ========== 日志配置 ==========
# 日志级别：DEBUG, INFO, WARNING, ERROR
# DEBUG: 详细调试信息
# INFO: 一般信息
# WARNING: 警告信息
# ERROR: 错误信息
LOG_LEVEL=INFO

# ========== 功能开关 ==========
# 启用 Prometheus 指标收集（用于监控）
ENABLE_METRICS=true
# 启用审计日志（记录所有管理员操作）
ENABLE_AUDIT_LOG=true
# 启用优雅关闭（收到 SIGTERM 时优雅关闭）
ENABLE_GRACEFUL_SHUTDOWN=true

# ========== 安全配置 ==========
# 强制 HTTPS（生产环境建议启用）
ENFORCE_HTTPS=true
# 会话密钥轮换间隔（秒）- 用于前向保密性
SESSION_KEY_ROTATION_INTERVAL=300
# 房间超时时间（秒）- 超过此时间的房间将被清理
ROOM_TIMEOUT=600

# ========== 数据库配置 ==========
# 数据库路径
DB_PATH=./data/storage.db
# 数据库连接池大小
DB_POOL_SIZE=5

# ========== 服务器配置 ==========
# 应用监听端口
PORT=5000

# ========== Telegram 通知（可选） ==========
# Telegram Bot Token（用于发送通知）
TG_BOT_TOKEN=
# Telegram 管理员 ID（接收通知的用户 ID）
TG_ADMIN_ID=

# ========== Telegram Bot（机器.py / docker-compose.bot.yml）==========
# BotFather 提供的机器人 Token
BOT_TOKEN=
# 管理员 Telegram 数字 ID；也可以只设置 OWNER_ID
ADMIN_ID=
OWNER_ID=
# Bot 专用 Redis/PostgreSQL 配置，默认只在 Docker 内网使用，不暴露公网端口
POSTGRES_DB=bot_db
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=change_me_strong
REDIS_ENABLED=true
# 首次从旧 SQLite 导入 PostgreSQL 时临时设为 true，导入完成后改回 false
MIGRATE_SQLITE_TO_POSTGRES=false
# 默认使用按钮验证码；如需兼容旧的文本数字回复，设为 true
CAPTCHA_TEXT_FALLBACK=false

# ========== CORS 配置 ==========
# 允许的源（逗号分隔，* 表示允许所有）
CORS_ORIGINS=*

# ========== IP 过滤（可选） ==========
# 启用 IP 白名单
ENABLE_IP_WHITELIST=false
# IP 白名单（逗号分隔）
IP_WHITELIST=

# 启用 IP 黑名单
ENABLE_IP_BLACKLIST=false
# IP 黑名单（逗号分隔）
IP_BLACKLIST=

# ========== 请求签名验证（可选） ==========
# 启用请求签名验证
ENABLE_REQUEST_SIGNATURE=false
# 签名算法
SIGNATURE_ALGORITHM=HMAC-SHA256
# 签名请求头
SIGNATURE_HEADER=X-Signature
# 时间戳请求头
SIGNATURE_TIMESTAMP_HEADER=X-Timestamp
# 签名时间容差（秒）
SIGNATURE_TOLERANCE_SECONDS=300

